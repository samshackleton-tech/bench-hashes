 /// The root's node: the last chunk's (or the top two values' parent),
 /// folded into the stack's values from the top.
 pub fn final_node<C: Chunk, N, K: Nodes<C, N>>(k: &K, chunk: &C, stack: &CvStack) -> N {
     if stack.len() == 0 {
         return k.chunk_node(chunk);
     }
