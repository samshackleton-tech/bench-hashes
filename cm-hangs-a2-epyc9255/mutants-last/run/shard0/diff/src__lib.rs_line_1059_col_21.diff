 #[inline(always)]
 pub(crate) fn max_subtree_len(input_offset: u64) -> Option<u64> {
     if input_offset == 0 {
         return None;
     }
     assert_eq!(input_offset % CHUNK_LEN as u64, 0);
     let counter = input_offset / CHUNK_LEN as u64;
     let max_chunks = 1 << counter.trailing_zeros();
