+            result.copy_from_slice(next[2 * k..2 * k + 2].as_flattened());
+        } else {
+            result[..OUT_LEN].copy_from_slice(&level[k]);
+        }
+        hashers[i].take_held(&result);
+    }
+    true
 }
 
