	.att_syntax
	.text
	.p2align	5
	.global	probe
	.type	probe, %function
probe:
	vmovdqu	(%rdi), %ymm0
	vmovdqu	32(%rdi), %ymm1
	vpaddd	%ymm1, %ymm0, %ymm0
	vpxor	%ymm1, %ymm0, %ymm0
	vpslld	$25, %ymm0, %ymm1
	vpsrld	$7, %ymm0, %ymm0
	vpor	%ymm1, %ymm0, %ymm0
	vmovdqu	%ymm0, (%rdi)
	ret
