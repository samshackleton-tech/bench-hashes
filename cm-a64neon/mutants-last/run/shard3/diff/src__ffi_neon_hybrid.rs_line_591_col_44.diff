 /// E -36%); at two blocks (1100 B) P-cores paid 14%.
 pub fn partial_pays(n: usize, len: usize) -> bool {
-    partial_covers(n) && (n > 1 || len > 4 * BLOCK_LEN)
+    partial_covers(n) && (n > 1 || len > 4 + /* ~ changed by cargo-mutants ~ */ BLOCK_LEN)
 }
 
