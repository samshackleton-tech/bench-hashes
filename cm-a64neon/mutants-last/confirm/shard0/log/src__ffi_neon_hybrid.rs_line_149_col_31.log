 /// portable compression's time, and through x1 0.97 (VM, BLAKE3 #190).
 pub fn xof_block(cv: &CVWords, block: &[u8; BLOCK_LEN], block_len: u8, counter: u64, flags: u8) -> [u8; BLOCK_LEN] {
     let mut out = [0u8; BLOCK_LEN];
