 fn spare_pool() -> Option<(&'static Pool, Caller<'static>)> {
     let pool = pool();
     let callers = pool.callers.fetch_add(1, Ordering::SeqCst) + 1;
     let caller = Caller(&pool.callers);
     (callers < pool.threads).then_some((pool, caller))
 }
