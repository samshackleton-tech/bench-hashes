         hash_group_across(&messages, len, key, flags, digests, platform);
     }
 }
 
 /// The most messages [`hash_group_across`] takes at once: the widest lanes.
 #[cfg(target_arch = "x86_64")]
 pub(crate) const ACROSS_GROUP: usize = 16;
 


