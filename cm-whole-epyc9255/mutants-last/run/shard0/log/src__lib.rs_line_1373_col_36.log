         if self.position_within_block == BLOCK_LEN as u8 {
             self.inner.counter += 1;
             self.position_within_block = 0;
         }
         // Advance the dest buffer. mem::take() is a borrowck workaround.
         *buf = &mut core::mem::take(buf)[take..];
     }
 


